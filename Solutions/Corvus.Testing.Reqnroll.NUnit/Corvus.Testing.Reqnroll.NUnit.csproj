<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Copyright>Copyright (c) Endjin Limited 2026. All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <TestProject>false</TestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- This project takes depedency on nUnit that adds the TestContainer capability importing NUnit.props, but this is not a test project -->
    <ProjectCapability Remove="TestContainer" />
  </ItemGroup>
  <ItemGroup>
    <!-- Metapackage with no real code: opt out of the analyzers referenced centrally in Directory.Packages.props. -->
    <GlobalPackageReference Remove="@(GlobalPackageReference)" />
  </ItemGroup>

  <PropertyGroup>
    <Description>A metapackage that references everything needed to write Reqnroll specs with NUnit and Corvus.Testing.Reqnroll: Reqnroll.NUnit, NUnit3TestAdapter, Microsoft.NET.Test.Sdk, coverlet.msbuild and Microsoft.Extensions.DependencyInjection. Updating this one package keeps them all in step.</Description>
    <PackageTags>reqnroll;bdd;gherkin;testing;nunit;metapackage;corvus</PackageTags>
    <RootNamespace>MetaPackage.Reqnroll.NUnit</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Suppress the NuGet warning we're always going to get - ref: https://github.com/NuGet/Home/issues/8583 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild">
      <!-- ensure the 'build' assets are not private -->
      <PrivateAssets>contentfiles; analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk">
      <!-- ensure the 'build' assets are not private -->
      <PrivateAssets>contentfiles; analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <!-- ensure the 'build' assets are not private -->
      <PrivateAssets>contentfiles; analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Reqnroll.NUnit">
      <!-- ensure the 'build' assets are not private -->
      <PrivateAssets>contentfiles; analyzers</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Corvus.Testing.Reqnroll\Corvus.Testing.Reqnroll.csproj" />
  </ItemGroup>

</Project>
